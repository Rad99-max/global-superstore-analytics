	measure 'Cust Type Unprofitable Customers %' = ```
			
			    VAR Yr = SELECTEDVALUE ( 'dwh dim_date'[calendar_year] )
			    VAR Types = VALUES ( 'Customer Type'[Type Sort] )
			    VAR Cur = VALUES ( 'mart customer_monthly'[customer_key] )
			    VAR Prior = CALCULATETABLE ( VALUES ( 'mart customer_monthly'[customer_key] ), REMOVEFILTERS ( 'dwh dim_date' ), 'dwh dim_date'[calendar_year] < Yr )
			    VAR Sel = UNION ( FILTER ( EXCEPT ( Cur, Prior ), 1 IN Types ), FILTER ( INTERSECT ( Cur, Prior ), 2 IN Types ) )
			    RETURN
			        SWITCH ( TRUE (),
			            ISBLANK ( [Cust Sales] ), BLANK (),
			            NOT ISFILTERED ( 'Customer Type' ), [Cust Unprofitable Customers %],
			            ISBLANK ( Yr ) || ISEMPTY ( Prior ), BLANK (),
