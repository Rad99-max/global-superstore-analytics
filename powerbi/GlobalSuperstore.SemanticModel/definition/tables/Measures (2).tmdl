			    RETURN IF ( HASONEVALUE ( 'dwh dim_date'[calendar_year] ), CALCULATE ( [Cust Type Profit Margin], REMOVEFILTERS ( 'dwh dim_date' ), TREATAS ( M, 'dwh dim_date'[YearMonthSort] ) ) )
