	measure 'Geo Insight Scale & Return' =
			VAR ScopeSales = [Geo Sales]
			VAR ScopeProfit = [Geo Profit]
			VAR AllSales = CALCULATE([Geo Sales], REMOVEFILTERS('dwh dim_geography'))
			VAR AllProfit = CALCULATE([Geo Profit], REMOVEFILTERS('dwh dim_geography'))
			VAR Markets =
			    FILTER(
			        ADDCOLUMNS(VALUES('dwh dim_geography'[market]), "__S", [Geo Sales], "__P", [Geo Profit]),
			        NOT ISBLANK([__S])
			    )
			VAR Leader = TOPN(1, Markets, [__S], DESC, 'dwh dim_geography'[market], ASC)
			VAR LeaderName = CONCATENATEX(Leader, 'dwh dim_geography'[market], "")
			VAR LeaderSales = SUMX(Leader, [__S])
			VAR LeaderProfit = SUMX(Leader, [__P])
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(ScopeSales), "No data for the selected period.",
			        COUNTROWS(Markets) = 1,
			            [Geo Territory Context] & ": "
			                & FORMAT(DIVIDE(ScopeSales, AllSales), "0.00%", "en-US") & " of all-market Sales"
			                & UNICHAR(10)
			                & FORMAT(DIVIDE(ScopeProfit, AllProfit), "0.00%", "en-US") & " of all-market Profit",
			        "Largest market by Sales: " & LeaderName
			            & UNICHAR(10)
			            & FORMAT(DIVIDE(LeaderSales, ScopeSales), "0.00%", "en-US") & " of Sales | "
			            & FORMAT(DIVIDE(LeaderProfit, ScopeProfit), "0.00%", "en-US") & " of Profit"
			    )
		displayFolder: Market Performance\Insights
		lineageTag: 96d0e234-2d09-4e71-82a8-274fbd7a0027

	measure 'Geo Insight Change Watch' =
			VAR Regions =
			    FILTER(
			        ADDCOLUMNS(VALUES('dwh dim_geography'[region]), "__D", [Geo Profit Change vs PY]),
			        NOT ISBLANK([__D])
			    )
			VAR RegionCount = COUNTROWS(Regions)
			VAR Higher = COUNTROWS(FILTER(Regions, [__D] > 0)) + 0
			VAR Lower = COUNTROWS(FILTER(Regions, [__D] < 0)) + 0
			VAR MinRow = TOPN(1, Regions, [__D], ASC, 'dwh dim_geography'[region], ASC)
			VAR MaxRow = TOPN(1, Regions, [__D], DESC, 'dwh dim_geography'[region], ASC)
			VAR SignedK = "+#,0.0;-#,0.0;0.0"
			VAR MinText =
			    CONCATENATEX(MinRow, 'dwh dim_geography'[region], "") & " "
			        & FORMAT(SUMX(MinRow, [__D]) / 1000, SignedK, "en-US") & "K"
			VAR MaxText =
			    CONCATENATEX(MaxRow, 'dwh dim_geography'[region], "") & " "
			        & FORMAT(SUMX(MaxRow, [__D]) / 1000, SignedK, "en-US") & "K"
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK([Geo Sales]), "No data for the selected period.",
			        ISBLANK(RegionCount), "Prior-year comparison is unavailable.",
			        RegionCount = 1, "Profit change vs PY: " & MaxText,
			        "Regions vs PY Profit: " & Higher & " higher | " & Lower & " lower"
			            & UNICHAR(10)
			            & "Min: " & MinText & " | Max: " & MaxText
			    )
		displayFolder: Market Performance\Insights
		lineageTag: 8c6cce8a-2f45-4446-aa97-d17955a8acc8

	measure 'Geo Insight Country Loss Concentration' =
			VAR HasPY = HASONEVALUE('dwh dim_date'[calendar_year])
			VAR PriorMonths =
			    SELECTCOLUMNS(VALUES('dwh dim_date'[YearMonthSort]), "PriorMonth", 'dwh dim_date'[YearMonthSort] - 100)
			VAR SalesPY =
			    IF(HasPY, CALCULATE([Geo Sales],
			        REMOVEFILTERS('dwh dim_date'), TREATAS(PriorMonths, 'dwh dim_date'[YearMonthSort])))
			VAR T =
			    ADDCOLUMNS(
			        VALUES('dwh dim_geography'[country]),
			        "__P", [Geo Profit],
			        "__PY", CALCULATE([Geo Profit],
			            REMOVEFILTERS('dwh dim_date'), TREATAS(PriorMonths, 'dwh dim_date'[YearMonthSort])))
			VAR Both = FILTER(T, NOT ISBLANK([__P]) && [__P] < 0 && NOT ISBLANK([__PY]) && [__PY] < 0)
			VAR NewL = FILTER(T, NOT ISBLANK([__P]) && [__P] < 0 && NOT (NOT ISBLANK([__PY]) && [__PY] < 0))
			VAR Exited = FILTER(T, NOT ISBLANK([__PY]) && [__PY] < 0 && NOT (NOT ISBLANK([__P]) && [__P] < 0))
			VAR BothN = COUNTROWS(Both) + 0
			VAR NewN = COUNTROWS(NewL) + 0
			VAR ExitedN = COUNTROWS(Exited) + 0
			VAR BothLoss = SUMX(Both, [__P]) + 0
			VAR BothLossPY = SUMX(Both, [__PY]) + 0
			VAR NewLoss = SUMX(NewL, [__P]) + 0
			VAR MoneyK = "#,0.0;-#,0.0;0.0"
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK([Geo Sales]), "No data for the selected period.",
			        NOT HasPY || ISBLANK(SalesPY), "Prior-year comparison is unavailable.",
			        BothN + NewN + ExitedN = 0, "No loss-making countries in the selected period or PY.",
			        "Loss-making both years: " & FORMAT(BothN, "#,0", "en-US")
			            & " | " & FORMAT(BothLoss / 1000, MoneyK, "en-US") & "K"
			            & " vs PY " & FORMAT(BothLossPY / 1000, MoneyK, "en-US") & "K"
			            & UNICHAR(10)
			            & "New loss-making: " & FORMAT(NewN, "#,0", "en-US")
			            & " | " & FORMAT(NewLoss / 1000, MoneyK, "en-US") & "K"
			            & " | No longer: " & FORMAT(ExitedN, "#,0", "en-US")
			    )
		displayFolder: Market Performance\Insights
		lineageTag: 12ebd8e0-07d3-41e8-9b19-2675ad361050

	measure 'Geo Territory Context' =
			VAR __GeoC=VALUES('dwh dim_geography'[country])
			VAR __GeoR=VALUES('dwh dim_geography'[region])
			VAR __GeoM=VALUES('dwh dim_geography'[market])
			RETURN SWITCH(TRUE(),
			HASONEVALUE('dwh dim_geography'[country])&&HASONEVALUE('dwh dim_geography'[region]),SELECTEDVALUE('dwh dim_geography'[country]) & " · " & SELECTEDVALUE('dwh dim_geography'[region]),
			HASONEVALUE('dwh dim_geography'[country]),SELECTEDVALUE('dwh dim_geography'[country]),
			HASONEVALUE('dwh dim_geography'[region]),SELECTEDVALUE('dwh dim_geography'[region]),
			HASONEVALUE('dwh dim_geography'[market]),SELECTEDVALUE('dwh dim_geography'[market]),
			ISFILTERED('dwh dim_geography'[country])||ISFILTERED('dwh dim_geography'[region])||ISFILTERED('dwh dim_geography'[market]),"Selected territories",
			"All markets")
		displayFolder: Market Performance\Display
		lineageTag: 8f0f5c3c-4da9-4d65-9065-7428390f408b

