	measure 'Cust Insight New vs Returning' =
			VAR Yr = SELECTEDVALUE('dwh dim_date'[calendar_year])
			VAR HasHistory = NOT ISBLANK(CALCULATE([Cust Sales], REMOVEFILTERS('dwh dim_date'), 'dwh dim_date'[calendar_year] < Yr))
			VAR T =
			    ADDCOLUMNS(
			        FILTER(VALUES('dwh dim_customer'[customer_key]), NOT ISBLANK([Cust Customers])),
			        "__S", [Cust Sales],
			        "__P", [Cust Profit],
			        "__F", YEAR(CALCULATE(MIN('mart customer_monthly'[month_date]), REMOVEFILTERS('dwh dim_date'))))
			VAR NewT = FILTER(T, [__F] = Yr)
			VAR RetT = FILTER(T, [__F] < Yr)
			VAR Pct = "0.0%"
			RETURN
			    SWITCH(TRUE(),
			        ISBLANK([Cust Sales]), "No data for the selected period.",
			        ISBLANK(Yr) || NOT HasHistory, "New vs returning split is unavailable.",
			        "New customers: " & FORMAT(COUNTROWS(NewT) + 0, "#,0", "en-US")
			            & " | Margin " & IF(COUNTROWS(NewT) > 0, FORMAT(DIVIDE(SUMX(NewT, [__P]), SUMX(NewT, [__S])), Pct, "en-US"), "n/a")
			            & " | Unprofitable " & IF(COUNTROWS(NewT) > 0, FORMAT(DIVIDE(COUNTROWS(FILTER(NewT, [__P] < 0)) + 0, COUNTROWS(NewT)), Pct, "en-US"), "n/a")
			            & UNICHAR(10)
			            & "Returning: " & FORMAT(COUNTROWS(RetT) + 0, "#,0", "en-US")
			            & " | Margin " & IF(COUNTROWS(RetT) > 0, FORMAT(DIVIDE(SUMX(RetT, [__P]), SUMX(RetT, [__S])), Pct, "en-US"), "n/a")
			            & " | Unprofitable " & IF(COUNTROWS(RetT) > 0, FORMAT(DIVIDE(COUNTROWS(FILTER(RetT, [__P] < 0)) + 0, COUNTROWS(RetT)), Pct, "en-US"), "n/a"))
		displayFolder: Customer Portfolio\Insight
		lineageTag: 9855b00c-0b02-4ca2-b4da-f624a429d903

	measure 'Cust Insight Retention' =
			VAR M = SELECTCOLUMNS(VALUES('dwh dim_date'[YearMonthSort]), "PriorMonth", 'dwh dim_date'[YearMonthSort] - 100)
			VAR T =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('dwh dim_customer'[customer_key]),
			            "__PPY", CALCULATE([Cust Profit], REMOVEFILTERS('dwh dim_date'), TREATAS(M, 'dwh dim_date'[YearMonthSort])),
			            "__C", [Cust Customers],
			            "__P", [Cust Profit]),
			        NOT ISBLANK([__PPY]))
			VAR PYN = COUNTROWS(T)
			VAR Ret = COUNTROWS(FILTER(T, NOT ISBLANK([__C]))) + 0
			VAR UPY = FILTER(T, [__PPY] < 0)
			RETURN
			    SWITCH(TRUE(),
			        ISBLANK([Cust Sales]), "No data for the selected period.",
			        NOT HASONEVALUE('dwh dim_date'[calendar_year]) || ISBLANK(PYN), "Prior-year comparison is unavailable.",
			        "PY customers returned: " & FORMAT(Ret, "#,0", "en-US") & " of " & FORMAT(PYN, "#,0", "en-US")
			            & " (" & FORMAT(DIVIDE(Ret, PYN), "0.0%", "en-US") & ")"
			            & UNICHAR(10)
			            & "PY unprofitable " & FORMAT(COUNTROWS(UPY) + 0, "#,0", "en-US")
			            & ": again " & FORMAT(COUNTROWS(FILTER(UPY, NOT ISBLANK([__P]) && [__P] < 0)) + 0, "#,0", "en-US")
			            & " | now profitable " & FORMAT(COUNTROWS(FILTER(UPY, [__P] > 0)) + 0, "#,0", "en-US")
			            & " | not returned " & FORMAT(COUNTROWS(FILTER(UPY, ISBLANK([__C]))) + 0, "#,0", "en-US"))
		displayFolder: Customer Portfolio\Insight
		lineageTag: cbd3a138-9271-4b95-a99f-110e4366f2a4

	measure 'Cust Insight Discount Loss' =
			VAR T =
			    ADDCOLUMNS(
			        FILTER(VALUES('dwh dim_customer'[customer_key]), NOT ISBLANK([Cust Profit])),
			        "__P", [Cust Profit], "__P30", [Cust Profit 30%+], "__S30", [Cust Sales 30%+])
			VAR U = FILTER(T, [__P] < 0)
			VAR LossTotal = SUMX(U, [__P]) + 0
			VAR Loss30 = SUMX(U, [__P30]) + 0
			VAR SignedK = "+#,0.0;-#,0.0;0.0"
			RETURN
			    SWITCH(TRUE(),
			        ISBLANK([Cust Sales]), "No data for the selected period.",
			        COUNTROWS(U) + 0 = 0, "No unprofitable customers in the selected period.",
			        "Unprofitable customers: 30%+ lines " & FORMAT(Loss30 / 1000, SignedK, "en-US") & "K"
			            & " (" & FORMAT(DIVIDE(Loss30, LossTotal), "0.0%", "en-US") & " of loss)"
			            & " | other lines " & FORMAT((LossTotal - Loss30) / 1000, SignedK, "en-US") & "K"
			            & UNICHAR(10)
			            & "Unprofitable with 30%+ lines: " & FORMAT(COUNTROWS(FILTER(U, [__S30] > 0)) + 0, "#,0", "en-US")
			            & " | 30%+ in profitable customers: "
			            & FORMAT((SUMX(FILTER(T, [__P] > 0), [__P30]) + 0) / 1000, SignedK, "en-US") & "K")
		displayFolder: Customer Portfolio\Insight
		lineageTag: 95d548b8-e81b-4d6a-873a-0915bdbacda9

	measure 'Cust Band Customers' =
			VAR Bands = 'Customer Size Band'
			VAR InBand =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'dwh dim_customer'[customer_key] ), "@Sales", [Cust Sales] ),
			        VAR S = [@Sales]
			        RETURN
			            NOT ISBLANK ( S )
			                && NOT ISEMPTY (
			                    FILTER ( Bands,
			                        S >= 'Customer Size Band'[Min Sales]
			                            && ( ISBLANK ( 'Customer Size Band'[Max Sales] ) || S < 'Customer Size Band'[Max Sales] ) ) )
			    )
			RETURN IF ( ISBLANK ( [Cust Sales] ), BLANK (), COUNTROWS ( InBand ) + 0 )
		formatString: #,0
		displayFolder: Customer Portfolio\Size Band
		lineageTag: 686d7ca3-e4bd-4c1f-ba46-0eae712bceb2

