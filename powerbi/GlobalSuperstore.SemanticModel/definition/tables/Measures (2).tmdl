	measure 'Profit Margin Δ pp' =
			
			VAR CurrentRate = [Profit Margin]
			VAR PreviousRate = [Profit Margin PY]
			RETURN
			    IF(
			        ISBLANK(CurrentRate) || ISBLANK(PreviousRate),
			        BLANK(),
			        (CurrentRate - PreviousRate) * 100
			    )
		formatString: 0.00
		lineageTag: 32003564-c624-438b-ad58-b6151df622f6

