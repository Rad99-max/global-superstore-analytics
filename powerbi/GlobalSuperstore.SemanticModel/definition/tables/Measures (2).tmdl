	measure 'Growth Quality' =
			VAR Share = DIVIDE([Line Loss-Making Sales Lines], [Line Sales Lines])
			VAR SharePY = DIVIDE([Line Loss-Making Sales Lines PY], [Line Sales Lines PY])
			VAR Delta = ROUND((Share - SharePY) * 100, 2)
			VAR CurrentText = "Loss-making line share " & FORMAT(Share, "0.00%", "en-US")
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Share), "No sales lines in the selected period.",
			        ISBLANK(SharePY), CurrentText & UNICHAR(10) & "Prior-year comparison is unavailable.",
			        CurrentText & " | PY " & FORMAT(SharePY, "0.00%", "en-US")
			            & UNICHAR(10)
			            & "Change vs PY: " & FORMAT(IF(Delta = 0, 0, Delta), "+0.00;-0.00;0.00", "en-US") & " pp"
			    )
		displayFolder: Business Insights
		lineageTag: d2362aa1-7f15-42c4-a2cf-f40e140936af

	measure 'Loss Exposure' =
			VAR FocusCategories = {"30%+", "MIXED"}
			VAR TotalLoss =
			    CALCULATE([Order Discount Loss], REMOVEFILTERS('OrderDiscountCategory'))
			VAR FocusLoss =
			    CALCULATE([Order Discount Loss], REMOVEFILTERS('OrderDiscountCategory'),
			        'OrderDiscountCategory'[order_discount_category] IN FocusCategories)
			VAR Share = DIVIDE(FocusLoss, TotalLoss)
			VAR HasPY = HASONEVALUE('dwh dim_date'[calendar_year])
			VAR TotalLossPY =
			    IF(HasPY, CALCULATE([Order Discount Loss], REMOVEFILTERS('OrderDiscountCategory'),
			        SAMEPERIODLASTYEAR('dwh dim_date'[calendar_date])))
			VAR FocusLossPY =
			    IF(HasPY, CALCULATE([Order Discount Loss], REMOVEFILTERS('OrderDiscountCategory'),
			        'OrderDiscountCategory'[order_discount_category] IN FocusCategories,
			        SAMEPERIODLASTYEAR('dwh dim_date'[calendar_date])))
			VAR SharePY = DIVIDE(FocusLossPY, TotalLossPY)
			VAR CurrentText =
			    "30%+ and MIXED: " & FORMAT(Share, "0.00%", "en-US") & " of order-level loss"
			        & UNICHAR(10)
			        & FORMAT(FocusLoss / 1000, "#,0.0", "en-US") & "K of "
			        & FORMAT(TotalLoss / 1000, "#,0.0", "en-US") & "K"
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Share), "No order-level loss in the selected period.",
			        ISBLANK(SharePY), CurrentText & " | Prior-year comparison is unavailable.",
			        CurrentText & " | PY " & FORMAT(SharePY, "0.00%", "en-US")
			    )
		displayFolder: Business Insights
		lineageTag: a037139c-2cd9-4721-b0a7-145610a79970

	measure 'Margin Watch' =
			VAR HighDiscountGroups = {"20–30%", "30%+"}
			VAR TotalSales =
			    CALCULATE([Profitability Sales], REMOVEFILTERS('BusinessDiscountGroup'))
			VAR GroupSales =
			    CALCULATE([Profitability Sales], REMOVEFILTERS('BusinessDiscountGroup'),
			        'BusinessDiscountGroup'[discount_group] IN HighDiscountGroups)
			VAR GroupProfit =
			    CALCULATE([Profitability Profit], REMOVEFILTERS('BusinessDiscountGroup'),
			        'BusinessDiscountGroup'[discount_group] IN HighDiscountGroups)
			VAR HasPY = HASONEVALUE('dwh dim_date'[calendar_year])
			VAR TotalSalesPY =
			    IF(HasPY, CALCULATE([Profitability Sales], REMOVEFILTERS('BusinessDiscountGroup'),
			        SAMEPERIODLASTYEAR('dwh dim_date'[calendar_date])))
			VAR GroupSalesPY =
			    IF(HasPY, CALCULATE([Profitability Sales], REMOVEFILTERS('BusinessDiscountGroup'),
			        'BusinessDiscountGroup'[discount_group] IN HighDiscountGroups,
			        SAMEPERIODLASTYEAR('dwh dim_date'[calendar_date])))
			VAR GroupProfitPY =
			    IF(HasPY, CALCULATE([Profitability Profit], REMOVEFILTERS('BusinessDiscountGroup'),
			        'BusinessDiscountGroup'[discount_group] IN HighDiscountGroups,
			        SAMEPERIODLASTYEAR('dwh dim_date'[calendar_date])))
			VAR MoneyK = "#,0.0;-#,0.0;0.0"
			VAR CurrentText =
			    "Discount 20–30% and 30%+: " & FORMAT(DIVIDE(GroupSales, TotalSales), "0.00%", "en-US")
			        & " of Sales | Profit " & FORMAT(GroupProfit / 1000, MoneyK, "en-US") & "K"
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(TotalSales), "No sales in the selected period.",
			        ISBLANK(TotalSalesPY), CurrentText & UNICHAR(10) & "Prior-year comparison is unavailable.",
			        CurrentText & UNICHAR(10)
			            & "PY: " & FORMAT(DIVIDE(GroupSalesPY, TotalSalesPY), "0.00%", "en-US")
			            & " of Sales | Profit " & FORMAT(GroupProfitPY / 1000, MoneyK, "en-US") & "K"
			    )
		displayFolder: Business Insights
		lineageTag: df38ed97-5df5-4931-bb6b-f6eb46bf19ee

