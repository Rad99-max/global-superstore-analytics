	measure 'Prod Insight Discount Loss' =
			VAR T =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('dwh dim_product'[product_key]),
			            "__P", [Prod Profit],
			            "__P30", [Prod Profit 30%+],
			            "__P0", CALCULATE([Prod Profit], KEEPFILTERS('mart product_monthly'[discount_group] = "0%")),
			            "__S0", CALCULATE([Prod Sales], KEEPFILTERS('mart product_monthly'[discount_group] = "0%"))),
			        NOT ISBLANK([__P]) && [__P] < 0)
			VAR LossN = COUNTROWS(T) + 0
			VAR LossTotal = SUMX(T, [__P]) + 0
			VAR Loss30 = SUMX(T, [__P30]) + 0
			VAR Loss0 = SUMX(T, [__P0]) + 0
			VAR LossOther = LossTotal - Loss30 - Loss0
			VAR OnlyDisc = FILTER(T, ISBLANK([__S0]))
			VAR SignedK = "+#,0.0;-#,0.0;0.0"
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK([Prod Sales]), "No data for the selected period.",
			        LossN = 0, "No loss-making products in the selected period.",
			        "Loss-making products: 30%+ " & FORMAT(Loss30 / 1000, SignedK, "en-US") & "K"
			            & " | other discounts " & FORMAT(LossOther / 1000, SignedK, "en-US") & "K"
			            & " | no discount " & FORMAT(Loss0 / 1000, SignedK, "en-US") & "K"
			            & UNICHAR(10)
			            & "Sold only with discount: " & FORMAT(COUNTROWS(OnlyDisc) + 0, "#,0", "en-US")
			            & " | " & FORMAT((SUMX(OnlyDisc, [__P]) + 0) / 1000, SignedK, "en-US") & "K"
			    )
		displayFolder: Product Portfolio\Insight
		lineageTag: f663def4-c406-457c-ac85-4626c4214546

	measure 'Prod Insight Discount Mix' =
			VAR S = [Prod Sales]
			VAR SPY = [Prod Sales PY]
			VAR S30 = COALESCE([Prod Sales 30%+], 0)
			VAR P30 = COALESCE([Prod Profit 30%+], 0)
			VAR S30PY = COALESCE(CALCULATE([Prod Sales PY], KEEPFILTERS('mart product_monthly'[discount_group] = "30%+")), 0)
			VAR P30PY = COALESCE(CALCULATE([Prod Profit PY], KEEPFILTERS('mart product_monthly'[discount_group] = "30%+")), 0)
			VAR M = DIVIDE([Prod Profit] - P30, S - S30)
			VAR MPY = DIVIDE([Prod Profit PY] - P30PY, SPY - S30PY)
			VAR Pct = "0.0%"
			VAR SignedK = "+#,0.0;-#,0.0;0.0"
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(S), "No data for the selected period.",
			        ISBLANK(SPY), "Prior-year comparison is unavailable.",
			        "30%+ discount: " & FORMAT(DIVIDE(S30, S), Pct, "en-US")
			            & " of sales (PY " & FORMAT(DIVIDE(S30PY, SPY), Pct, "en-US") & ")"
			            & " | Profit " & FORMAT(P30 / 1000, SignedK, "en-US") & "K"
			            & " (PY " & FORMAT(P30PY / 1000, SignedK, "en-US") & "K)"
			            & UNICHAR(10)
			            & "Margin excl. 30%+: " & IF(ISBLANK(M), "n/a", FORMAT(M, Pct, "en-US"))
			            & " (PY " & IF(ISBLANK(MPY), "n/a", FORMAT(MPY, Pct, "en-US")) & ")"
			    )
		displayFolder: Product Portfolio\Insight
		lineageTag: 020e03d2-4ae5-4762-a77b-a45db52f90cf

