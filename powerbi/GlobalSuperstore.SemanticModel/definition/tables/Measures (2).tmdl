	measure 'Geo Country Net Loss Share %' =
			VAR CountryProfit = [Geo Profit]
			VAR ScopeLoss = CALCULATE([Geo Net Loss in Loss-Making Countries], REMOVEFILTERS('dwh dim_geography'[country]))
			RETURN IF(NOT ISBLANK(CountryProfit) && CountryProfit < 0, DIVIDE(ABS(CountryProfit), ABS(ScopeLoss)))
