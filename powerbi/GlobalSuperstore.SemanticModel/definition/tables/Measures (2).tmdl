			VAR InBand =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'dwh dim_customer'[customer_key] ), "@Sales", [Cust Sales], "@Profit", [Cust Profit] ),
			        VAR S = [@Sales]
			        RETURN
			            NOT ISBLANK ( S )
			                && NOT ISEMPTY (
