	measure 'Geo Country Loss Display Flag' =
			VAR Countries = ADDCOLUMNS(ALLSELECTED('dwh dim_geography'[country]), "__Profit", [Geo Profit])
			VAR LossCountries = FILTER(Countries, NOT ISBLANK([__Profit]) && [__Profit] < 0)
			VAR Worst = TOPN(10, LossCountries, [__Profit], ASC, 'dwh dim_geography'[country], ASC)
			VAR CurrentCountry = SELECTEDVALUE('dwh dim_geography'[country])
			RETURN IF(NOT ISBLANK(CurrentCountry) && CONTAINS(Worst, 'dwh dim_geography'[country], CurrentCountry), 1, 0)
		formatString: 0
