	measure 'Cust Cohort Profitable Profit' =
			
			VAR SelDates =
			    CALCULATETABLE ( VALUES ( 'dwh dim_date'[calendar_date] ), ALLSELECTED ( 'dwh dim_date' ) )
			VAR Cohort =
			    CALCULATETABLE (
			        FILTER ( VALUES ( 'dwh dim_customer'[customer_key] ), [Cust Profit] > 0 ),
			        REMOVEFILTERS ( 'dwh dim_date' ),
			        SelDates
			    )
			VAR Result =
			    CALCULATE ( [Cust Profit], KEEPFILTERS ( Cohort ) )
			RETURN
			    IF ( NOT ISBLANK ( [Cust Sales] ), COALESCE ( Result, 0 ) )
