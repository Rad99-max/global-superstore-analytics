	measure 'Geo Country Loss Coverage Label' =
			VAR ScopeSales = CALCULATE([Geo Sales], ALLSELECTED('dwh dim_geography'[country]))
			VAR CountryCount = CALCULATE([Geo Loss-Making Countries], ALLSELECTED('dwh dim_geography'[country]))
			VAR ShownCount = MIN(10, CountryCount)
			VAR Share = [Geo Top 10 Country Net Loss Share %]
			RETURN SWITCH(TRUE(),
			    ISBLANK(ScopeSales), "No data for the selected period.",
			    CountryCount = 0, "No loss-making countries in the selected period.",
			    "Top " & FORMAT(ShownCount, "0", "en-US") & " of " & FORMAT(CountryCount, "#,0", "en-US")
			        & " loss-making countries: " & FORMAT(Share, "0.00%", "en-US") & " of Net Loss.")
