	measure 'Tooltip Period' = SELECTEDVALUE('mart executive_monthly'[YearMonth])
		lineageTag: f97a135f-e355-4d86-9a63-5e9947c5f701

	measure 'Insight Growth' =
			VAR HasCurrentData = NOT ISBLANK([Sales]) || NOT ISBLANK([Profit]) || NOT ISBLANK([Orders])
			VAR HasComparison = NOT ISBLANK([Sales PY]) && NOT ISBLANK([Profit PY]) && NOT ISBLANK([Orders PY])
			VAR SignedK = "+#,0.0;-#,0.0;0.0"
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT HasCurrentData, "No data for the selected period.",
			        NOT HasComparison, "Prior-year comparison is unavailable.",
			        "Change vs PY: Sales " & FORMAT(([Sales] - [Sales PY]) / 1000, SignedK, "en-US") & "K"
			            & " | Profit " & FORMAT(([Profit] - [Profit PY]) / 1000, SignedK, "en-US") & "K"
			            & " | Orders " & FORMAT([Orders] - [Orders PY], "+#,0;-#,0;0", "en-US")
			            & UNICHAR(10)
			            & "PY: Sales " & FORMAT([Sales PY] / 1000, "#,0.0", "en-US") & "K"
			            & " | Profit " & FORMAT([Profit PY] / 1000, "#,0.0", "en-US") & "K"
			            & " | Orders " & FORMAT([Orders PY], "#,0", "en-US")
			    )
		lineageTag: eb561469-3c2c-47fb-9294-5ab20fef0206

	measure 'Insight Margin' =
			VAR PreviousMargin = [Profit Margin PY]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK([Profit Margin]), "No data for the selected period.",
			        ISBLANK(PreviousMargin), "Prior-year comparison is unavailable.",
			        "Profit Margin PY " & FORMAT(PreviousMargin, "0.00%", "en-US")
			    )
		lineageTag: d607d2b5-8b1d-4fdd-a01c-179933bf5011

	measure 'Insight Risk' =
			VAR PreviousOrders = [Orders PY]
			VAR PreviousUnprofitable =
			    CALCULATE([Unprofitable Orders], SAMEPERIODLASTYEAR('dwh dim_date'[calendar_date]))
			VAR CurrentText =
			    "Unprofitable orders: " & FORMAT([Unprofitable Orders], "#,0", "en-US")
			        & " of " & FORMAT([Orders], "#,0", "en-US")
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK([Orders]), "No data for the selected period.",
			        ISBLANK(PreviousOrders), CurrentText & UNICHAR(10) & "Prior-year comparison is unavailable.",
			        CurrentText & UNICHAR(10)
			            & "PY: " & FORMAT(PreviousUnprofitable, "#,0", "en-US")
			            & " of " & FORMAT(PreviousOrders, "#,0", "en-US")
			            & " (" & FORMAT([Unprofitable Order Rate PY], "0.00%", "en-US") & ")"
			    )
		lineageTag: f2aec0b7-a523-4be4-92fc-f772f5ceb96f

	measure 'Reporting Period' =
			VAR SelectedYears = VALUES('dwh dim_date'[calendar_year])
			VAR YearCount = COUNTROWS(SelectedYears)
			VAR MinYear = MINX(SelectedYears, 'dwh dim_date'[calendar_year])
			VAR MaxYear = MAXX(SelectedYears, 'dwh dim_date'[calendar_year])
			VAR SelectedQuarters = VALUES('dwh dim_date'[calendar_quarter])
			VAR QuarterCount = COUNTROWS(SelectedQuarters)
			VAR MinQuarter = MINX(SelectedQuarters, 'dwh dim_date'[calendar_quarter])
			VAR MaxQuarter = MAXX(SelectedQuarters, 'dwh dim_date'[calendar_quarter])
			VAR QuarterText =
			    SWITCH(
			        TRUE(),
			        QuarterCount = 4 || QuarterCount = 0, "",
			        QuarterCount = 1,
			            "Q" & FORMAT(MinQuarter, "0", "en-US") & " ",
			        MaxQuarter - MinQuarter + 1 = QuarterCount,
			            "Q" & FORMAT(MinQuarter, "0", "en-US")
			                & "-Q" & FORMAT(MaxQuarter, "0", "en-US") & " ",
			        CONCATENATEX(
			            SelectedQuarters,
			            "Q" & FORMAT('dwh dim_date'[calendar_quarter], "0", "en-US"),
			            ", ",
			            'dwh dim_date'[calendar_quarter], ASC
			        ) & " "
			    )
			VAR PeriodText =
			    IF(
			        YearCount = 1,
			        QuarterText & FORMAT(MinYear, "0", "en-US"),
			        FORMAT(MinYear, "0", "en-US")
			            & "–" & FORMAT(MaxYear, "0", "en-US")
			    )
			RETURN
			    IF(
			        YearCount = 0,
			        BLANK(),
			        "Reporting Period: " & IF(
			                HASONEVALUE('dwh dim_date'[YearMonthSort]),
			                FORMAT(MIN('dwh dim_date'[calendar_date]), "MMM yyyy", "en-US"),
			                PeriodText
			            )
			    )
		lineageTag: 02dc38d4-6d8f-40f6-a8ce-bae367b79a84

