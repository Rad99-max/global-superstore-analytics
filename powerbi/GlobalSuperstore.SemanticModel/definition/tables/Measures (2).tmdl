	measure 'Prod Insight Sub-Category' =
			VAR SubCats =
			    FILTER(
			        ADDCOLUMNS(VALUES('dwh dim_product'[sub_category]), "__D", [Prod Profit Change vs PY]),
			        NOT ISBLANK([__D])
			    )
			VAR SubCatCount = COUNTROWS(SubCats)
			VAR Higher = COUNTROWS(FILTER(SubCats, [__D] > 0)) + 0
			VAR Lower = COUNTROWS(FILTER(SubCats, [__D] < 0)) + 0
			VAR UpRow = TOPN(1, FILTER(SubCats, [__D] > 0), [__D], DESC, 'dwh dim_product'[sub_category], ASC)
			VAR DownRow = TOPN(1, FILTER(SubCats, [__D] < 0), [__D], ASC, 'dwh dim_product'[sub_category], ASC)
			VAR SignedK = "+#,0.0;-#,0.0;0.0"
			VAR UpText =
			    IF(Higher = 0, "none",
			        CONCATENATEX(UpRow, 'dwh dim_product'[sub_category], "") & " "
			            & FORMAT(SUMX(UpRow, [__D]) / 1000, SignedK, "en-US") & "K")
			VAR DownText =
			    IF(Lower = 0, "none",
			        CONCATENATEX(DownRow, 'dwh dim_product'[sub_category], "") & " "
			            & FORMAT(SUMX(DownRow, [__D]) / 1000, SignedK, "en-US") & "K")
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK([Prod Sales]), "No data for the selected period.",
			        ISBLANK(SubCatCount), "Prior-year comparison is unavailable.",
			        SubCatCount = 1,
			            "Profit change vs PY: " & CONCATENATEX(SubCats, 'dwh dim_product'[sub_category], "") & " "
			                & FORMAT(SUMX(SubCats, [__D]) / 1000, SignedK, "en-US") & "K",
			        "Sub-categories vs PY Profit: " & Higher & " higher | " & Lower & " lower of " & SubCatCount
			            & UNICHAR(10)
			            & "Largest rise: " & UpText & " | Largest drop: " & DownText
			    )
		displayFolder: Product Portfolio\Insight
		lineageTag: 2245e361-8ddc-4868-a6fd-54b0426030f0

