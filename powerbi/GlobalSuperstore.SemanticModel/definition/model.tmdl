model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ru-RU
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dwh dim_date","dwh dim_customer","dwh dim_product","dwh dim_geography","mart executive_monthly","mart sales_profitability_monthly","mart geographic_monthly","mart customer_monthly","mart product_monthly","BusinessDiscountGroup","mart order_discount_monthly","OrderDiscountCategory","mart sales_line_profitability_monthly","Measures (2)"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table 'dwh dim_date'
ref table 'dwh dim_customer'
ref table 'dwh dim_product'
ref table 'dwh dim_geography'
ref table 'mart executive_monthly'
ref table 'mart sales_profitability_monthly'
ref table 'mart geographic_monthly'
ref table 'mart customer_monthly'
ref table 'mart product_monthly'
ref table BusinessDiscountGroup
ref table 'Measures (2)'
ref table 'mart order_discount_monthly'
ref table OrderDiscountCategory
ref table 'mart sales_line_profitability_monthly'
ref table 'Customer Size Band'
ref table 'Customer Type'

ref cultureInfo en-US

