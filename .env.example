# Example configuration. Copy the keys into the files named below and fill in
# the values locally. Never commit real .env files (they are in .gitignore).
# pipeline/config.py reads .env, then .env.local, then .env.dev or .env.prod.

# --- .env: database connection ---
POSTGRES_HOST=
POSTGRES_PORT=
# Must be sales_dwh (checked in pipeline/config.py)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- .env.local: profile switch ---
# Must be exactly 0 (use .env.dev) or 1 (use .env.prod)
USE_PROD_ENV=

# --- .env.dev / .env.prod: profile overrides ---
# Same POSTGRES_* keys as in .env (password may stay only in .env).
# PIPELINE_ENV is informational; the code does not use it to pick the profile.
PIPELINE_ENV=
